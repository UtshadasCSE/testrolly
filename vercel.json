{
  "version": 2,
  "functions": {
    "api/*.ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{src/data/**,server/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
